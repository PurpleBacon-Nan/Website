# Base44 dev defaults — placeholders only, committed on purpose.
#
# These exist so the app can boot with no credentials at all. Real values are
# delivered by the platform to /run/base44/app.env, which is listed AFTER this
# file in docker-compose.base44.yml, so anything the user provides in the
# Base44 dashboard overrides the values below.
#
# SECRET_KEY is intentionally NOT set here: it is a real app secret and is
# delivered from /run/base44/app.env (see .base44/environment.json).

# Django settings module (manage.py defaults to this anyway).
DJANGO_SETTINGS_MODULE=PP.settings

# Development server: DEBUG on so the app serves its static files and shows
# useful tracebacks while working in the sandbox. PP/settings.py defaults to
# DEBUG=False when this is unset.
DEBUG=True
